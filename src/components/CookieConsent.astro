---
import { locales } from '../i18n/index.js';

const { language } = Astro.props;
const text = locales[language].cookieConsent;
---

<aside class="cookie-consent" id="cookie-consent" role="dialog" aria-modal="false" aria-labelledby="cookie-consent-title" hidden>
  <div class="cookie-consent-copy">
    <h2 id="cookie-consent-title">{text.title}</h2>
    <p>{text.description} <a href={language === 'en' ? '/en/cookies/' : '/cookies/'}>{text.informationLink}</a></p>
  </div>
  <div class="cookie-consent-actions">
    <button type="button" data-cookie-choice="reject">{text.reject}</button>
    <button type="button" data-cookie-choice="accept">{text.accept}</button>
  </div>
</aside>

<script>
  (() => {
      const consentKey = 'kinfelina-cookie-consent-v1';
      const panel = document.getElementById('cookie-consent');
      const feed = document.querySelector('.sk-instagram-feed');
      const placeholder = document.getElementById('instagram-consent-placeholder');
      let widgetLoaded = false;

      const getConsent = () => {
        try {
          const saved = JSON.parse(localStorage.getItem(consentKey) || 'null');
          if (saved && saved.expires > Date.now()) return saved.choice;
          if (saved) localStorage.removeItem(consentKey);
        } catch { /* Ignore invalid stored preferences. */ }
        return null;
      };

      const loadWidget = () => {
        if (!feed || widgetLoaded) return;
        widgetLoaded = true;
        if (placeholder) placeholder.hidden = true;
        const script = document.createElement('script');
        script.src = 'https://widgets.sociablekit.com/instagram-feed/widget.js';
        script.defer = true;
        script.onerror = () => {
          widgetLoaded = false;
          if (placeholder) placeholder.hidden = false;
        };
        document.head.appendChild(script);
      };

      const showPanel = () => { if (panel) panel.hidden = false; };
      const savedChoice = getConsent();
      if (savedChoice === 'accepted') loadWidget();
      else if (feed && savedChoice === 'rejected' && placeholder) placeholder.hidden = false;
      else if (feed) showPanel();

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest('.open-cookie-settings')) {
          event.preventDefault();
          showPanel();
          return;
        }
        const button = target?.closest('[data-cookie-choice]');
        if (!button || !panel?.contains(button)) return;
        const choice = button.dataset.cookieChoice === 'accept' ? 'accepted' : 'rejected';
        try {
          localStorage.setItem(consentKey, JSON.stringify({ choice, expires: Date.now() + 180 * 24 * 60 * 60 * 1000 }));
        } catch { /* Continue for this visit if browser storage is unavailable. */ }
        panel.hidden = true;
        if (choice === 'accepted') loadWidget();
        else {
          if (placeholder) placeholder.hidden = false;
          if (widgetLoaded) window.location.reload();
        }
      });
  })();
</script>
