---
import AboutContent from '@/components/AboutContent.astro';
import ColoniesContent from '@/components/ColoniesContent.astro';
import ContactContent from '@/components/ContactContent.astro';
import DonationsContent from '@/components/DonationsContent.astro';
import HomeContent from '@/components/HomeContent.astro';
import PhilosophyContent from '@/components/PhilosophyContent.astro';
import { locales } from '@/i18n/index.js';

const { language, pageId } = Astro.props;
const locale = locales[language];
const page = locale.pages[pageId];
const pageComponents = {
  home: HomeContent,
  about: AboutContent,
  philosophy: PhilosophyContent,
  colonies: ColoniesContent,
  donations: DonationsContent,
  contact: ContactContent
};
const PageComponent = pageComponents[pageId];
---

{pageId === 'home' ? null : (
  <section class="page-heading">
    <div class="wrap">
      <div class="kicker">{page.eyebrow}</div>
      <h1>{page.title}</h1>
      <p class="lead">{page.intro}</p>
    </div>
  </section>
)}

<PageComponent language={language} locale={locale} page={page} />
