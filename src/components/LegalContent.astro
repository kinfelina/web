---
const { language, page, pageMeta, kind } = Astro.props;
---

<section class="content-section legal-page">
  <div class="wrap">
    <header class="section-head"><span class="eyebrow">{pageMeta.eyebrow}</span><h1>{pageMeta.title}</h1><p>{pageMeta.intro}</p></header>

    {kind === 'legalNotice' && <section class="legal-block">
      <dl>
        <dt>{page.ownerLabel}</dt><dd>{page.ownerName}</dd>
        <dt>{page.addressLabel}</dt><dd>{page.addressValue}</dd>
        <dt>{page.taxIdLabel}</dt><dd>{page.taxIdValue}</dd>
        <dt>{page.nationalRegistryLabel}</dt><dd>{page.nationalRegistry}</dd>
        <dt>{page.emailLabel}</dt><dd><a href={`mailto:${page.emailValue}`}>{page.emailValue}</a></dd>
      </dl>
      <p>{page.noticeText}</p>
    </section>}

    {kind === 'privacy' && <section class="legal-block">
      <h2>{page.controllerTitle}</h2><p>{page.controllerText}</p>
      <h2>{page.contactDataTitle}</h2><p>{page.contactDataText}</p>
      <h2>{page.basisTitle}</h2><p>{page.basisText} <a href="https://www.netlify.com/privacy/" target="_blank" rel="noopener noreferrer">{page.netlifyPrivacyLink}</a>.</p>
      <h2>{page.recipientsTitle}</h2><p>{page.recipientsText}</p>
      <h2>{page.retentionTitle}</h2><p>{page.retentionText} <a href="https://docs.netlify.com/manage/forms/submissions/" target="_blank" rel="noopener noreferrer">{page.netlifySubmissionsLink}</a>.</p>
      <h2>{page.rightsTitle}</h2><p>{page.rightsText} <a href="https://www.aepd.es/">{page.aepdLinkLabel}</a>.</p>
    </section>}

    {kind === 'cookies' && <section class="legal-block">
      <p>{page.cookiesIntro}</p>
      <ul>
        <li>{page.languageStorage}</li>
        <li>{page.consentStorage}</li>
        <li>{page.widgetStorage}</li>
      </ul>
      <p>{page.cookiesControl} <button type="button" class="text-button open-cookie-settings">{page.openSettings}</button>.</p>
      <p>{page.widgetProvider} <a href="https://www.sociablekit.com/privacy-policy/" target="_blank" rel="noopener noreferrer">{page.sociableKitLinkLabel}</a>.</p>
    </section>}
  </div>
</section>
