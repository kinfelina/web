---
const { locale, language } = Astro.props;
const legalNoticePath = language === 'en' ? '/en/legal-notice/' : '/aviso-legal/';
const privacyPath = language === 'en' ? '/en/privacy/' : '/privacidad/';
const cookiesPath = language === 'en' ? '/en/cookies/' : '/cookies/';
---

<footer>
  <div class="wrap footer-inner">
    <div class="footer-association">
      <strong>{locale.footer.legalName}</strong>
      <nav class="footer-legal" aria-label={locale.footer.navigationLabel}>
        <a href={legalNoticePath}>{locale.footer.legalNoticeLabel}</a>
        <a href={privacyPath}>{locale.footer.privacyLabel}</a>
        <a href={cookiesPath}>{locale.footer.cookiesLabel}</a>
        <button type="button" class="open-cookie-settings">{locale.footer.cookieSettingsLabel}</button>
      </nav>
    </div>
    <div class="footer-signature">
      <span>{locale.footer.signature}</span>
      <a href="https://tau.studio" target="_blank" rel="noopener noreferrer" aria-label="Diseñado por Tau Studio" style="display:inline-flex;align-items:center;gap:.45rem;font-size:.8125rem;font-weight:500;text-decoration:none;color:inherit;opacity:.65;">
        <img src="https://tau.studio/tau.svg" alt="Tau Studio" width="18" height="18" loading="lazy" decoding="async" />
        <span>Desarrollado por Tau Studio</span>
      </a>
    </div>
  </div>
</footer>
