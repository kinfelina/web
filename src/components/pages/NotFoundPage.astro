---
const { page, language = 'es' } = Astro.props;
const homeHref = language === 'en' ? '/en/' : '/';
const homeLabel = page.homeLabel;
---

<section class="not-found-section">
  <div class="wrap not-found-card">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-title">{page.title}</h1>
    <p class="not-found-intro" id="not-found-intro">{page.intro}</p>
    <div class="not-found-actions">
      <a class="btn btn-primary" href={homeHref}>{homeLabel}</a>
    </div>
  </div>
</section>
