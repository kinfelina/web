---
import logo from '../assets/logo-kin-felina.jpeg';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '../styles/styles.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { languages, locales } from '../i18n/index.js';
import { getLocalizedPath } from '../i18n/routes.js';

const { language, pageId } = Astro.props;
const locale = locales[language];
const page = locale.pages[pageId];
const canonical = new URL(getLocalizedPath(language, pageId), Astro.site);
const socialImagePath = language === 'en' ? '/og/kin-felina-en-og.jpg' : '/og/kin-felina-og.jpg';
const socialImage = new URL(socialImagePath, Astro.site).href;
const socialImageAlt = language === 'en'
  ? 'Kin Felina caring for community cats in Sorbas'
  : 'Kin Felina cuida de los gatos comunitarios de Sorbas';
const alternates = languages.map((alternateLanguage) => ({
  language: locales[alternateLanguage].locale,
  href: new URL(getLocalizedPath(alternateLanguage, pageId), Astro.site)
}));
const organizationUrl = new URL('/#organization', Astro.site).href;
const websiteUrl = new URL('/#website', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationUrl,
      name: 'Asociación Kin Felina - Gestión Ética de Colonias Felinas',
      url: Astro.site.href,
      logo: new URL(logo.src, Astro.site).href,
      email: 'asoc.kinfelina@gmail.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Barriada de Moras nº7',
        addressLocality: 'Sorbas',
        addressRegion: 'Almería',
        postalCode: '04279',
        addressCountry: 'ES'
      },
      sameAs: ['https://www.instagram.com/asoc.kinfelina/']
    },
    {
      '@type': 'WebSite',
      '@id': websiteUrl,
      url: Astro.site.href,
      name: 'Kin Felina',
      publisher: { '@id': organizationUrl },
      inLanguage: languages.map((item) => locales[item].locale)
    },
    {
      '@type': 'WebPage',
      '@id': canonical.href,
      url: canonical.href,
      name: `${page.title} · Kin Felina`,
      description: page.description,
      isPartOf: { '@id': websiteUrl },
      about: { '@id': organizationUrl },
      inLanguage: locale.locale
    }
  ]
};
---

<!doctype html>
<html lang={locale.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description} />
    <meta name="author" content="Kin Felina" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#617653" />
    <title>{page.title} · Kin Felina</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.language} href={alternate.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath('es', pageId), Astro.site)} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kin Felina" />
    <meta property="og:title" content={`${page.title} · Kin Felina`} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.locale.replace('-', '_')} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${page.title} · Kin Felina`} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <Header language={language} pageId={pageId} />
    <main id="contenido">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      {`
        (() => {
          const languagePreferenceKey = 'kinfelina-language';
          const currentPath = window.location.pathname.replace(/\\/+$/, '') || '/';
          const savedLanguage = window.localStorage.getItem(languagePreferenceKey);
          const preferredLanguages = navigator.languages || [navigator.language];
          const prefersEnglish = preferredLanguages.some((item) => item.toLowerCase().startsWith('en'));

          document.addEventListener('click', (event) => {
            const languageLink = event.target.closest('[data-language]');
            if (languageLink) {
              window.localStorage.setItem(languagePreferenceKey, languageLink.dataset.language);
            }
          });

          if (currentPath === '/' && !savedLanguage && prefersEnglish) {
            window.location.replace('/en/');
          }
        })();
      `}
    </script>
  </body>
</html>
