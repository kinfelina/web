---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageContent from '@/components/PageContent.astro';
import { locales } from '@/i18n/index.js';

export function getStaticPaths() {
  return locales.en.navigation.map((route) => ({
    params: { lang: 'en', slug: route.slug },
    props: { language: 'en', pageId: route.id }
  }));
}

const { language, pageId } = Astro.props;
---

<SiteLayout language={language} pageId={pageId}>
  <PageContent language={language} pageId={pageId} />
</SiteLayout>